# Firebase project config. NOT a secret — Firebase's web config is meant to be public; access is
# controlled by Firestore Security Rules (see firestore.rules) and the account's own Google sign-in,
# not by hiding these values. See src/firebase.ts.
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyD0_3fKzeoFs0m7JBmUM-znK5VobQNOm8g
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=runbutan-acb85.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=runbutan-acb85
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=runbutan-acb85.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=787019203001
EXPO_PUBLIC_FIREBASE_APP_ID=1:787019203001:web:411138029ef2c3f23f3668
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-860VYB9ZTK

# Google Sign-In. The Web client ID is Firebase's own (safe to expose — see src/auth.ts for why the
# app doesn't actually use it on Android). The Android client ID is an "Android" type OAuth client
# from Google Cloud Console, tied to:
#   Package name:  com.runbutan.app
#   SHA-1:         6A:FD:0B:2A:0C:5C:A0:7A:AB:74:8E:81:F7:D7:F9:69:14:54:30:59
# (that SHA-1 is keystores/debug.keystore's — the one every CI build is signed with; a new build
# signed with a different keystore needs a new Android OAuth client registered against its SHA-1).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=787019203001-qbc8s27pnqfb62rp12e7q48i82gi231c.apps.googleusercontent.com
# The iOS client ID is an "iOS" type OAuth client tied to bundle id com.runbutan.app (no SHA-1 on
# iOS); its reversed form is registered as the app's URL scheme in app.json (google-signin plugin).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=787019203001-2de4t4nr3pum7iqq2khf4mlutsenlo9j.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=787019203001-sso78vkvshhrgk66d2orgn1pu9ktqubv.apps.googleusercontent.com
